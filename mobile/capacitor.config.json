{
  "appId": "com.makjal.kainlee",
  "appName": "Kainlee",
  "webDir": "www",
  "server": {
    "url": "https://forefirst.org/admin",
    "errorPath": "offline.html",
    "allowNavigation": [
      "forefirst.org",
      "*.forefirst.org"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#00572D",
    "preferredContentMode": "mobile",
    "appendUserAgent": "KainleeApp",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#00572D",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
