# Copy these into Hostinger → your Node.js app → Environment variables.
# (For local testing, copy this file to .env.local and fill it in.)

# MySQL database created in hPanel → Databases. Use 127.0.0.1 (not "localhost").
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_kainlee
DB_USER=u123456789_kainlee
DB_PASSWORD=change-me

# A long random string (at least 32 characters). Keep it secret; changing it logs everyone out.
SESSION_SECRET=paste-a-long-random-string-here

# Optional: the public address used in WhatsApp links. Leave unset to use whatever
# address the site is opened on. Set it when you switch domains, e.g. https://lali-guras.in
# SITE_URL=https://forefirst.makjal.com
